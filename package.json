{
  "name": "sunflower-playwright-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright TypeScript POM automation with Allure reporting",
  "scripts": {
    "test:e2e": "playwright test",
    "test:report": "node scripts/test-and-report.mjs",
    "allure:generate": "allure generate allure-results --clean --output allure-report",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.13.0",
    "typescript": "^5.9.3"
  }
}